# ==============================================================================
# PASSAPORTE DIGITAL GAMIFICADO (WEBAPP) — CAPIM DOURADO SHOPPING (PALMAS - TO)
# ==============================================================================

NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# BANCO DE DADOS OFICIAL: NEON SERVERLESS POSTGRESQL (us-east-2 / neondb)
# ==============================================================================
# Endpoint oficial do projeto: ep-ancient-sunset-bef18lgk

# Data API REST do Neon (PostgREST):
NEON_DATA_API_URL="https://ep-ancient-sunset-bef18lgk.apirest.c-9.us-east-2.aws.neon.tech/neondb/rest/v1"
NEXT_PUBLIC_NEON_DATA_API_URL="https://ep-ancient-sunset-bef18lgk.apirest.c-9.us-east-2.aws.neon.tech/neondb/rest/v1"

# Neon Auth & JWKS (JSON Web Key Set):
NEON_AUTH_URL="https://ep-ancient-sunset-bef18lgk.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth"
NEXT_PUBLIC_NEON_AUTH_URL="https://ep-ancient-sunset-bef18lgk.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-ancient-sunset-bef18lgk.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# 1. DATABASE_URL (Pooled Connection - usada pelo WebApp Next.js em execução)
DATABASE_URL="postgresql://neondb_owner:SUA_SENHA_AQUI@ep-ancient-sunset-bef18lgk-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# 2. DIRECT_URL (Direct Connection - usada pelo Prisma CLI para migrations / db push)
DIRECT_URL="postgresql://neondb_owner:SUA_SENHA_AQUI@ep-ancient-sunset-bef18lgk.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Segurança e Sessão JWT do WebApp (Cookies HttpOnly)
JWT_SECRET="troque-esta-chave-secreta-em-producao-min-32-caracteres-capim-dourado"
JWT_EXPIRES_IN_HOURS="168"

# Parâmetros Padrão de Geolocalização (Capim Dourado Shopping - Palmas/TO)
SHOPPING_CENTER_LAT="-10.1845"
SHOPPING_CENTER_LNG="-48.3337"
SHOPPING_GEOFENCE_RADIUS_METERS="250"

# Provedores Externos (Pendentes de Definição — Ver docs/DUVIDAS_E_PREMISSAS.md)
OTP_PROVIDER_MODE="mock" # mock | whatsapp_cloud | twilio
WHATSAPP_API_TOKEN=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MAILER_API_KEY=""
