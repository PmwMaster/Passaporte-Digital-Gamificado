// ==============================================================================
// PRISMA SCHEMA — PASSAPORTE DIGITAL GAMIFICADO (WEBAPP CAPIM DOURADO SHOPPING)
// ==============================================================================
// Banco Oficial: Neon Serverless PostgreSQL
// - DATABASE_URL: Conexão Pooled (PgBouncer do Neon) usada pelo WebApp Next.js
// - DIRECT_URL: Conexão Direta usada pelo Prisma CLI para migrations / db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================================================
// ENUMS NATIVOS DO POSTGRESQL (NEON)
// ==============================================================================

enum UserRole {
  VISITOR
  MERCHANT
  OPERATOR
  ADMIN
}

enum PassportLevel {
  BRONZE
  SILVER
  GOLD
  DIAMOND
}

enum StoreCategory {
  GASTRONOMIA
  MODA
  SERVICOS
  LAZER
  BELEZA
  TECNOLOGIA
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ENDED
}

enum CheckInStatus {
  VALID
  REJECTED_DISTANCE
  REJECTED_DUPLICATE
  REJECTED_QR
}

enum MissionFrequency {
  DAILY
  WEEKLY
  MONTHLY
  SPECIAL
}

enum MissionTargetType {
  CHECKIN_COUNT
  CATEGORY_VARIETY
  SPECIFIC_STORE
}

enum MissionStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum PointTransactionType {
  CREDIT
  DEBIT
}

enum PointTransactionOrigin {
  CHECKIN
  MISSION
  REWARD_REDEMPTION
  PROMO_BONUS
  ADMIN_ADJUSTMENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VoucherStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum AdminPermissionLevel {
  SUPER_ADMIN
  MARKETING
  AUDITOR
}

// ==============================================================================
// MODELOS DE DOMÍNIO (13 DOMÍNIOS + CONFIGURAÇÃO)
// ==============================================================================

model User {
  id                 String          @id @default(cuid())
  name               String
  email              String          @unique
  phone              String          @unique
  passwordHash       String
  role               UserRole        @default(VISITOR)
  isPhoneVerified    Boolean         @default(false)
  lgpdConsentAt      DateTime
  lgpdConsentVersion String          @default("1.0")
  optInMarketing     Boolean         @default(false)
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  visitorProfile     VisitorProfile?
  merchant           Merchant?
  operator           Operator?
  administrator      Administrator?
}

model OtpVerification {
  id         String   @id @default(cuid())
  phone      String   @unique
  codeHash   String
  attempts   Int      @default(0)
  expiresAt  DateTime
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())
}

model VisitorProfile {
  id                String             @id @default(cuid())
  userId            String             @unique
  memberCode        String             @unique
  level             PassportLevel      @default(BRONZE)
  currentPoints     Int                @default(0)
  lifetimePoints    Int                @default(0)
  totalCheckIns     Int                @default(0)
  totalStamps       Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIns          CheckIn[]
  stamps            Stamp[]
  missionProgress   MissionProgress[]
  pointTransactions PointTransaction[]
  vouchers          Voucher[]
}

model Store {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  category      StoreCategory
  floor         String
  unitNumber    String
  description   String        @db.Text
  logoUrl       String?
  coverUrl      String?
  qrCodeToken   String        @unique
  checkInPoints Int           @default(40)
  latitude      Float         @default(-10.1845)
  longitude     Float         @default(-48.3337)
  isFeatured    Boolean       @default(false)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  merchants     Merchant[]
  operators     Operator[]
  campaigns     Campaign[]
  checkIns      CheckIn[]
  stamps        Stamp[]
  rewards       Reward[]
  vouchers      Voucher[]
}

model Campaign {
  id                String         @id @default(cuid())
  storeId           String?
  title             String
  slug              String         @unique
  description       String         @db.Text
  bannerUrl         String?
  bonusMultiplier   Float          @default(1.0)
  status            CampaignStatus @default(PENDING_APPROVAL)
  startsAt          DateTime
  endsAt            DateTime
  approvedByAdminId String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  store             Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
}

model CheckIn {
  id               String         @id @default(cuid())
  visitorId        String
  storeId          String
  checkInDate      String         // Formato YYYY-MM-DD (Fuso America/Araguaia)
  latitude         Float
  longitude        Float
  distanceMeters   Float
  isWithinGeofence Boolean
  status           CheckInStatus
  pointsAwarded    Int            @default(0)
  createdAt        DateTime       @default(now())

  visitor          VisitorProfile @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  store            Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  stamps           Stamp[]

  @@index([visitorId, storeId, checkInDate])
}

model Stamp {
  id         String         @id @default(cuid())
  visitorId  String
  storeId    String
  checkInId  String
  badgeTitle String
  category   StoreCategory
  earnedAt   DateTime       @default(now())

  visitor    VisitorProfile @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  store      Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  checkIn    CheckIn        @relation(fields: [checkInId], references: [id], onDelete: Cascade)
}

model Mission {
  id             String            @id @default(cuid())
  code           String            @unique
  title          String
  description    String            @db.Text
  frequency      MissionFrequency
  targetType     MissionTargetType
  targetCategory StoreCategory?
  targetCount    Int
  rewardPoints   Int
  isActive       Boolean           @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime          @default(now())

  progress       MissionProgress[]
}

model MissionProgress {
  id           String         @id @default(cuid())
  visitorId    String
  missionId    String
  currentCount Int            @default(0)
  status       MissionStatus  @default(IN_PROGRESS)
  periodKey    String         // Ex.: 2026-11-13, 2026-W46, 2026-11
  completedAt  DateTime?
  updatedAt    DateTime       @updatedAt

  visitor      VisitorProfile @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  mission      Mission        @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([visitorId, missionId, periodKey])
}

model PointTransaction {
  id           String                 @id @default(cuid())
  visitorId    String
  type         PointTransactionType
  amount       Int
  balanceAfter Int
  origin       PointTransactionOrigin
  referenceId  String?
  description  String
  createdAt    DateTime               @default(now())

  visitor      VisitorProfile         @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([visitorId, createdAt])
}

model Reward {
  id                   String         @id @default(cuid())
  storeId              String
  title                String
  description          String         @db.Text
  rules                String         @db.Text
  imageUrl             String?
  pointsCost           Int
  initialStock         Int
  availableStock       Int
  maxPerVisitor        Int            @default(1)
  voucherValidityHours Int            @default(2)
  approvalStatus       ApprovalStatus @default(APPROVED)
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  store                Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  vouchers             Voucher[]
}

model Voucher {
  id                    String         @id @default(cuid())
  code                  String         @unique
  qrPayload             String         @unique
  visitorId             String
  rewardId              String
  storeId               String
  pointsSpent           Int
  status                VoucherStatus  @default(ACTIVE)
  issuedAt              DateTime       @default(now())
  expiresAt             DateTime
  usedAt                DateTime?
  validatedByOperatorId String?

  visitor               VisitorProfile @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  reward                Reward         @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  store                 Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  validatedByOperator   Operator?      @relation(fields: [validatedByOperatorId], references: [id], onDelete: SetNull)

  @@index([visitorId, status])
  @@index([storeId, status])
}

model Merchant {
  id         String   @id @default(cuid())
  userId     String   @unique
  storeId    String
  cnpj       String
  jobTitle   String   @default("Lojista Responsável")
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model Operator {
  id                String    @id @default(cuid())
  userId            String    @unique
  storeId           String
  badgeNumber       String
  canManageOffers   Boolean   @default(false)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  store             Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  validatedVouchers Voucher[]
}

model Administrator {
  id              String               @id @default(cuid())
  userId          String               @unique
  department      String               @default("Marketing & Operações")
  permissionLevel AdminPermissionLevel @default(SUPER_ADMIN)
  createdAt       DateTime             @default(now())

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemConfig {
  key         String   @id
  value       String
  description String
  updatedAt   DateTime @updatedAt
}
